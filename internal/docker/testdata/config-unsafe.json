{
  "name": "panel-t1",
  "networks": {
    "default": {
      "name": "panel-t1_default",
      "ipam": {}
    }
  },
  "services": {
    "db": {
      "command": null,
      "entrypoint": null,
      "image": "alpine",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/sock",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/etc/",
          "target": "/x",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/root/../etc",
          "target": "/y",
          "bind": {
            "create_host_path": true
          }
        }
      ]
    },
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "traefik/whoami",
      "ipc": "host",
      "network_mode": "host",
      "pid": "host",
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 80,
          "published": "18081",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "::1",
          "target": 80,
          "published": "18082",
          "protocol": "udp"
        },
        {
          "mode": "ingress",
          "target": 9000,
          "published": "9000",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 9001,
          "published": "9001",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "0.0.0.0",
          "target": 81,
          "published": "18083",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "protocol": "tcp"
        }
      ],
      "privileged": true,
      "volumes": [
        {
          "type": "bind",
          "source": "/etc",
          "target": "/host-etc",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "volume",
          "source": "data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/tmp/agent-docker/t1/local",
          "target": "/local",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock"
        },
        {
          "type": "bind",
          "source": "/",
          "target": "/rootfs",
          "bind": {
            "create_host_path": true
          }
        }
      ]
    }
  },
  "volumes": {
    "data": {
      "name": "panel-t1_data"
    }
  }
}