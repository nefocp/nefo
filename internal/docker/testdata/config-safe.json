{
  "name": "panel-demo",
  "networks": {
    "default": {
      "name": "panel-demo_default",
      "ipam": {}
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "TZ": "UTC"
      },
      "image": "traefik/whoami",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 80,
          "published": "18081",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "::1",
          "target": 80,
          "published": "18082",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/var/lib/panel-compose/demo/html",
          "target": "/usr/share/html",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/etc/localtime",
          "target": "/etc/localtime",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "tmpfs",
          "target": "/cache"
        }
      ]
    },
    "worker": {
      "command": [
        "sleep",
        "infinity"
      ],
      "depends_on": {
        "web": {
          "condition": "service_started",
          "restart": true,
          "required": true
        }
      },
      "entrypoint": null,
      "expose": [
        "9000"
      ],
      "image": "alpine",
      "network_mode": "service:web"
    }
  },
  "volumes": {
    "data": {
      "name": "panel-demo_data"
    }
  }
}